{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(git submodule:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git stash list:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(hugo:*)",
      "Bash(python3:*)",
      "Bash(pip3:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(echo:*)",
      "Bash(diff:*)",
      "Bash(bash scripts/:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(sudo:*)",
      "Read(./config/**)",
      "Bash(cat config/:*)",
      "Bash(cat ./config/:*)",
      "Bash(head config/:*)",
      "Bash(head ./config/:*)",
      "Bash(tail config/:*)",
      "Bash(tail ./config/:*)",
      "Bash(less config/:*)",
      "Bash(less ./config/:*)",
      "Bash(more config/:*)",
      "Bash(more ./config/:*)",
      "Bash(grep config/:*)",
      "Bash(grep ./config/:*)",
      "Bash(cp config/:*)",
      "Bash(cp ./config/:*)",
      "Bash(open config/:*)",
      "Bash(open ./config/:*)",
      "Bash(base64 config/:*)",
      "Bash(base64 ./config/:*)",
      "Bash(xxd config/:*)",
      "Bash(xxd ./config/:*)",
      "Bash(strings config/:*)",
      "Bash(strings ./config/:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session_start.sh\""
          }
        ]
      }
    ]
  }
}
